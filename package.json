{
  "name": "kuavatars",
  "private": true,
  "version": "0.1.0",
  "description": "Animated 2D SVG emoji avatars shared by Kudominoes and KuCards",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./faces": "./src/faces.ts",
    "./avatars.css": "./src/avatars.css"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
